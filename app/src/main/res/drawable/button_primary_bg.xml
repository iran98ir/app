<?xml version="1.0" encoding="utf-8"?>
<!-- =========================================================
     button_primary_bg.xml  —  پس‌زمینه‌ی دکمه‌ی اصلی
     مسیر: app/src/main/res/drawable/button_primary_bg.xml
     ========================================================= -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ===== حالت عادی ===== -->
    <item android:state_pressed="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/navy_primary" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="@color/navy_light" />
        </shape>
    </item>

    <!-- ===== حالت فشرده ===== -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/navy_light" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="@color/gold_primary" />
        </shape>
    </item>

    <!-- ===== حالت غیرفعال ===== -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/text_muted" />
            <corners android:radius="12dp" />
        </shape>
    </item>

</selector>
