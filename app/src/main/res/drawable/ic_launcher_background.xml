<?xml version="1.0" encoding="utf-8"?>
<!-- =========================================================
     splash_background.xml  —  پس‌زمینه‌ی Splash (کاردار)
     مسیر: app/src/main/res/drawable/splash_background.xml
     نسخه: 3.07.11
     =========================================================
     📌 گرادیانت آبی اینستاگرام لوکس
     ========================================================= -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ===== گرادیانت آبی اینستاگرام ===== -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#0074C2"
                android:centerColor="#0095F6"
                android:endColor="#4DB8FF"
                android:type="linear" />
        </shape>
    </item>

    <!-- ===== درخشش سفید مرکزی (هاله‌ی نرم) ===== -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="500dp"
                android:startColor="#33FFFFFF"
                android:endColor="@color/transparent" />
            <size
                android:width="800dp"
                android:height="800dp" />
        </shape>
    </item>

    <!-- ===== درخشش گوشه‌ی بالا-چپ (glass highlight) ===== -->
    <item android:gravity="top|left">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="300dp"
                android:startColor="#26FFFFFF"
                android:endColor="@color/transparent" />
            <size
                android:width="400dp"
                android:height="400dp" />
        </shape>
    </item>

</layer-list>
