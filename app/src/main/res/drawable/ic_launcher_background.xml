<!-- =========================================================
     ic_launcher_background.xml  —  پس‌زمینه‌ی آیکون (وامدار)
     مسیر: app/src/main/res/drawable/ic_launcher_background.xml
     نسخه: 7.11.02
     =========================================================
     📌 رنگ: سرمه‌ای تیره — مثل مشاور همراه اولیه
     ========================================================= -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ===== گرادیانت سرمه‌ای تیره ===== -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108">
                <item android:offset="0" android:color="#0D1B2E"/>
                <item android:offset="0.45" android:color="#1B2A4A"/>
                <item android:offset="1" android:color="#0D1B2E"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- ===== درخشش طلایی نرم بالا-چپ (شیشه‌ای) ===== -->
    <path android:pathData="M0,0 L108,0 L108,30 Q54,55 0,30 Z"
        android:fillAlpha="0.35">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="0" android:endY="30">
                <item android:offset="0" android:color="#C4956A"/>
                <item android:offset="1" android:color="#00C4956A"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- ===== هاله‌ی طلایی ملایم پایین (depth) ===== -->
    <path android:pathData="M0,108 L108,108 L108,60 Q54,95 0,60 Z"
        android:fillAlpha="0.25">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54" android:centerY="108"
                android:gradientRadius="70">
                <item android:offset="0" android:color="#C4956A"/>
                <item android:offset="1" android:color="#00C4956A"/>
            </gradient>
        </aapt:attr>
    </path>

</vector>
