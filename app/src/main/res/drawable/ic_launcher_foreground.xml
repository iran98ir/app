<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:translateX="18"
        android:translateY="18">

        <!-- ===== دسته‌ی بیل (خط مایل ضخیم، از بالا-راست به پایین-چپ) ===== -->
        <path android:pathData="M72,8 L32,68"
            android:strokeWidth="7"
            android:strokeLineCap="round"
            android:fillColor="#00000000">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="72" android:startY="8"
                    android:endX="32" android:endY="68">
                    <item android:offset="0" android:color="#1A2B3C"/>
                    <item android:offset="1" android:color="#000000"/>
                </gradient>
            </aapt:attr>
        </path>

        <!-- ===== هایلایت روی دسته (لبه‌ی روشن، شیشه‌ای) ===== -->
        <path android:pathData="M70,10 L33,65"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:strokeColor="#FFFFFF"
            android:strokeAlpha="0.25"
            android:fillColor="#00000000"/>

        <!-- ===== گره‌ی اتصال (وسط دسته، علامت اتصال تیغه) ===== -->
        <path android:pathData="M46,46
            a3,3 0 1,0 0,6
            a3,3 0 1,0 0,-6
            z"
            android:fillColor="#1A2B3C"/>

        <!-- ===== تیغه‌ی بیل (ذوزنقه در پایین-چپ) ===== -->
        <path android:pathData="M18,66 L42,66 L38,82 L14,82 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="14" android:startY="66"
                    android:endX="42" android:endY="82">
                    <item android:offset="0" android:color="#1A2B3C"/>
                    <item android:offset="1" android:color="#000000"/>
                </gradient>
            </aapt:attr>
        </path>

        <!-- ===== هایلایت روی تیغه (لبه‌ی بالا، شیشه‌ای) ===== -->
        <path android:pathData="M20,68 L40,68"
            android:strokeWidth="1.5"
            android:strokeLineCap="round"
            android:strokeColor="#FFFFFF"
            android:strokeAlpha="0.3"
            android:fillColor="#00000000"/>

        <!-- ===== خط زیر تیغه (حس عمق) ===== -->
        <path android:pathData="M16,82 L40,82"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:strokeColor="#1A2B3C"
            android:strokeAlpha="0.6"
            android:fillColor="#00000000"/>

    </group>

