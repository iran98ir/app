<?xml version="1.0" encoding="utf-8"?>
<!-- =========================================================
     ic_launcher_round.xml  —  آیکون اپ (وامدار) — نسخه‌ی گرد کامل
     مسیر: app/src/main/res/drawable/ic_launcher_round.xml
     نسخه: 7.11.02
     =========================================================
     📌 نماد: حرف V طلایی روی پس‌زمینه‌ی سرمه‌ای — مثل مشاور همراه اولیه
     ========================================================= -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="120"
    android:viewportHeight="120">

    <!-- ===== پس‌زمینه‌ی گرد کامل سرمه‌ای ===== -->
    <path android:pathData="M60,0
        a60,60 0 1,0 0,120
        a60,60 0 1,0 0,-120
        z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="120" android:endY="120">
                <item android:offset="0" android:color="#0D1B2E"/>
                <item android:offset="0.45" android:color="#1B2A4A"/>
                <item android:offset="1" android:color="#0D1B2E"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- ===== درخشش طلایی شیشه‌ای بالا-چپ (نصف بالایی) ===== -->
    <path android:pathData="M60,0 A60,60 0 0,1 120,60 A60,60 0 0,0 60,0 Z"
        android:fillAlpha="0.4">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="60" android:endY="60">
                <item android:offset="0" android:color="#C4956A"/>
                <item android:offset="1" android:color="#00C4956A"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- ===== هاله‌ی طلایی عمیق پایین ===== -->
    <path android:pathData="M60,120 A60,60 0 0,1 0,60 A60,60 0 0,0 60,120 Z"
        android:fillAlpha="0.3">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="60" android:centerY="120"
                android:gradientRadius="75">
                <item android:offset="0" android:color="#C4956A"/>
                <item android:offset="1" android:color="#00C4956A"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- ===== حلقه‌ی طلایی داخلی (برای عمق) ===== -->
    <path android:pathData="M60,8
        a52,52 0 1,0 0,104
        a52,52 0 1,0 0,-104
        z"
        android:strokeWidth="1.5"
        android:fillColor="#00000000"
        android:strokeColor="#C4956A"
        android:strokeAlpha="0.4" />

    <!-- ===== درخشش گوشه‌ی بالا-چپ حلقه (glass) ===== -->
    <path android:pathData="M24,24 Q40,10 60,8"
        android:strokeColor="#C4956A"
        android:strokeWidth="2.5"
        android:strokeAlpha="0.7"
        android:strokeLineCap="round"
        android:fillColor="#00000000"/>

    <!-- ===== گروه محتوای مرکزی (حرف V طلایی) ===== -->
    <group
        android:translateX="30"
        android:translateY="30">

        <!-- ===== بدنه‌ی V طلایی ===== -->
        <path
            android:fillColor="#C4956A"
            android:pathData="M6,10 L30,54 L54,10 L46,10 L30,42 L14,10 Z" />

        <!-- ===== نقطه‌ی بالای V ===== -->
        <path
            android:fillColor="#C4956A"
            android:pathData="M30,0
                a3.5,3.5 0 1,0 0,7
                a3.5,3.5 0 1,0 0,-7
                z" />

        <!-- ===== خط زیر V ===== -->
        <path
            android:strokeColor="#C4956A"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:fillColor="#00000000"
            android:pathData="M14,58 L46,58" />

    </group>

</vector>
