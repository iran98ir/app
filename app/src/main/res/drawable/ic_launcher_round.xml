<!-- =========================================================
     ic_launcher_round.xml  —  آیکون اپ (MU✂️MU) — نسخه‌ی گرد کامل
     مسیر: app/src/main/res/drawable/ic_launcher_round.xml
     نسخه: 3.4.07
     ========================================================= -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="120"
    android:viewportHeight="120">

    <!-- ===== پس‌زمینه‌ی گرد کامل صورتی روشن لوکس ===== -->
    <path android:pathData="M60,0
        a60,60 0 1,0 0,120
        a60,60 0 1,0 0,-120
        z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="120" android:endY="120">
                <item android:offset="0" android:color="#FFD9E8"/>
                <item android:offset="0.45" android:color="#FFC2D9"/>
                <item android:offset="1" android:color="#F5A8C5"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- ===== درخشش شیشه‌ای بالا-چپ (نصف بالایی) ===== -->
    <path android:pathData="M60,0 A60,60 0 0,1 120,60 A60,60 0 0,0 60,0 Z"
        android:fillAlpha="0.45">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="60" android:endY="60">
                <item android:offset="0" android:color="#FFFFFF"/>
                <item android:offset="1" android:color="#00FFFFFF"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- ===== هاله‌ی صورتی عمیق پایین ===== -->
    <path android:pathData="M60,120 A60,60 0 0,1 0,60 A60,60 0 0,0 60,120 Z"
        android:fillAlpha="0.3">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="60" android:centerY="120"
                android:gradientRadius="75">
                <item android:offset="0" android:color="#E87FA8"/>
                <item android:offset="1" android:color="#00E87FA8"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- ===== حلقه‌ی داخلی براق سفید-صورتی ===== -->
    <path android:pathData="M60,6
        a54,54 0 1,0 0,108
        a54,54 0 1,0 0,-108
        z"
        android:strokeWidth="2"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="6" android:startY="6"
                android:endX="114" android:endY="114">
                <item android:offset="0" android:color="#FFFFFF"/>
                <item android:offset="0.5" android:color="#FFF0F6"/>
                <item android:offset="1" android:color="#FFC8DD"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- ===== درخشش گوشه‌ی بالا-چپ حلقه (glass) ===== -->
    <path android:pathData="M24,24 Q40,10 60,8"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.5"
        android:strokeAlpha="0.7"
        android:strokeLineCap="round"
        android:fillColor="#00000000"/>

    <!-- ===== گروه محتوای مرکزی (M + قیچی) ===== -->
    <group
        android:translateX="20"
        android:translateY="24">

        <!-- ===== حرف M سفید براق ===== -->
        <path android:pathData="M14,56 L14,20 L26,20 L34,38 L42,20 L54,20 L54,56 L44,56 L44,34 L36,52 L32,52 L24,34 L24,56 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="14" android:startY="20"
                    android:endX="54" android:endY="56">
                    <item android:offset="0" android:color="#FFFFFF"/>
                    <item android:offset="1" android:color="#FFF0F6"/>
                </gradient>
            </aapt:attr>
        </path>

        <!-- ===== هایلایت شیشه‌ای بالای M ===== -->
        <path android:pathData="M16,22 L52,22 L52,26 L16,26 Z"
            android:fillColor="#FFFFFF"
            android:fillAlpha="0.5"/>

        <!-- ===== حلقه‌ی چپ قیچی ===== -->
        <path android:pathData="M12,60
            a4.5,4.5 0 1,0 0,9
            a4.5,4.5 0 1,0 0,-9
            z"
            android:fillColor="#FFFFFF"
            android:fillAlpha="0.95"/>

        <!-- ===== حلقه‌ی راست قیچی ===== -->
        <path android:pathData="M56,60
            a4.5,4.5 0 1,0 0,9
            a4.5,4.5 0 1,0 0,-9
            z"
            android:fillColor="#FFFFFF"
            android:fillAlpha="0.95"/>

        <!-- ===== تیغه‌ی چپ قیچی ===== -->
        <path android:pathData="M16,64.5 L30,48"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:fillColor="#00000000"/>

        <!-- ===== تیغه‌ی راست قیچی ===== -->
        <path android:pathData="M56,64.5 L42,48"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:fillColor="#00000000"/>

        <!-- ===== نقطه‌ی اتصال قیچی ===== -->
        <path android:pathData="M34,49
            a2,2 0 1,0 0,4
            a2,2 0 1,0 0,-4
            z"
            android:fillColor="#FFFFFF"
            android:fillAlpha="0.9"/>

    </group>

    <!-- ===== درخشش ستاره‌ای بزرگ بالا-راست ===== -->
    <path android:pathData="M96,22 L98,28 L104,30 L98,32 L96,38 L94,32 L88,30 L94,28 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.9"/>

    <!-- ===== درخشش کوچک پایین-چپ ===== -->
    <path android:pathData="M20,88 L21.5,92 L25.5,93.5 L21.5,95 L20,99 L18.5,95 L14.5,93.5 L18.5,92 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.7"/>

    <!-- ===== درخشش نقطه‌ای بالا-چپ ===== -->
    <path android:pathData="M28,20
        a2,2 0 1,0 0,4
        a2,2 0 1,0 0,-4
        z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.55"/>

    <!-- ===== درخشش نقطه‌ای پایین-راست (کوچک) ===== -->
    <path android:pathData="M96,92
        a1.5,1.5 0 1,0 0,3
        a1.5,1.5 0 1,0 0,-3
        z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.5"/>

</vector>
