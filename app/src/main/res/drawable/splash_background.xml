<?xml version="1.0" encoding="utf-8"?>
<!-- =========================================================
     splash_background.xml  —  پس‌زمینه‌ی Splash (وامدار)
     مسیر: app/src/main/res/drawable/splash_background.xml
     نسخه: 7.11.02
     =========================================================
     📌 گرادیانت سرمه‌ای تیره — مثل مشاور همراه اولیه
     ========================================================= -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ===== گرادیانت سرمه‌ای تیره ===== -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#0D1B2E"
                android:centerColor="#1B2A4A"
                android:endColor="#0D1B2E"
                android:type="linear" />
        </shape>
    </item>

    <!-- ===== درخشش طلایی مرکزی (هاله‌ی نرم) ===== -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="500dp"
                android:startColor="#1AC4956A"
                android:endColor="@color/transparent" />
            <size
                android:width="800dp"
                android:height="800dp" />
        </shape>
    </item>

</layer-list>
