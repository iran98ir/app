<?xml version="1.0" encoding="utf-8"?>
<!-- =========================================================
     splash_logo.xml  —  لوگوی صفحه‌ی Splash (کاردار)
     مسیر: app/src/main/res/drawable/splash_logo.xml
     نسخه: 3.07.11
     =========================================================
     📌 طراحی هماهنگ با آیکون لانچر
     📌 زرد تابلو + کارگر با بیل
     ========================================================= -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="140dp"
    android:height="140dp"
    android:viewportWidth="120"
    android:viewportHeight="120">

    <!-- ===== دایره‌ی پس‌زمینه‌ی زرد (گرادیانت) ===== -->
    <path android:pathData="M60,4
        a56,56 0 1,0 0,112
        a56,56 0 1,0 0,-112
        z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="4" android:startY="4"
                android:endX="116" android:endY="116">
                <item android:offset="0" android:color="#FFD933"/>
                <item android:offset="0.45" android:color="#FFCC00"/>
                <item android:offset="1" android:color="#E6B800"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- ===== درخشش شیشه‌ای بالا-چپ ===== -->
    <path android:pathData="M60,4 A56,56 0 0,1 116,60 A56,56 0 0,0 60,4 Z"
        android:fillAlpha="0.45">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="4" android:startY="4"
                android:endX="60" android:endY="60">
                <item android:offset="0" android:color="#FFFFFF"/>
                <item android:offset="1" android:color="#00FFFFFF"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- ===== هاله‌ی نارنجی عمیق پایین ===== -->
    <path android:pathData="M60,116 A56,56 0 0,1 4,60 A56,56 0 0,0 60,116 Z"
        android:fillAlpha="0.3">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="60" android:centerY="116"
                android:gradientRadius="70">
                <item android:offset="0" android:color="#CC8800"/>
                <item android:offset="1" android:color="#00CC8800"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- ===== حلقه‌ی زرد تیره‌تر داخلی (برای عمق) ===== -->
    <path android:pathData="M60,10
        a50,50 0 1,0 0,100
        a50,50 0 1,0 0,-100
        z"
        android:strokeWidth="1.5"
        android:fillColor="#00000000"
        android:strokeColor="#CC9900"
        android:strokeAlpha="0.4" />

    <!-- ===== گروه محتوای مرکزی (کارگر + بیل) ===== -->
    <group
        android:translateX="22"
        android:translateY="26">

        <!-- ===== سر کارگر ===== -->
        <path android:pathData="M30,6
            a6,6 0 1,0 0,12
            a6,6 0 1,0 0,-12
            z"
            android:fillColor="#1A2B3C"/>

        <!-- ===== بدن کارگر ===== -->
        <path android:pathData="M23,20 L37,20 L40,44 L20,44 Z"
            android:fillColor="#1A2B3C"/>

        <!-- ===== دست‌ها ===== -->
        <path android:pathData="M20,28 L46,22"
            android:strokeColor="#1A2B3C"
            android:strokeWidth="4.5"
            android:strokeLineCap="round"
            android:fillColor="#00000000"/>

        <!-- ===== پای چپ ===== -->
        <path android:pathData="M24,44 L20,58"
            android:strokeColor="#1A2B3C"
            android:strokeWidth="4.5"
            android:strokeLineCap="round"
            android:fillColor="#00000000"/>

        <!-- ===== پای راست ===== -->
        <path android:pathData="M34,44 L38,58"
            android:strokeColor="#1A2B3C"
            android:strokeWidth="4.5"
            android:strokeLineCap="round"
            android:fillColor="#00000000"/>

        <!-- ===== دسته‌ی بیل ===== -->
        <path android:pathData="M44,22 L24,58"
            android:strokeColor="#1A2B3C"
            android:strokeWidth="3"
            android:strokeLineCap="round"
            android:fillColor="#00000000"/>

        <!-- ===== تیغه‌ی بیل ===== -->
        <path android:pathData="M19,56 L30,56 L28,63 L21,63 Z"
            android:fillColor="#1A2B3C"/>

        <!-- ===== تپه‌ی خاک ===== -->
        <path android:pathData="M48,62 Q54,54 60,62 Z"
            android:fillColor="#1A2B3C"/>

        <!-- ===== خط زمین ===== -->
        <path android:pathData="M12,66 L68,66"
            android:strokeColor="#1A2B3C"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:fillColor="#00000000"/>

    </group>

</vector>
